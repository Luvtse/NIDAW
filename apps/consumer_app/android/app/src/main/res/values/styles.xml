<?xml version="1.0" encoding="utf-8"?>
<!--
  NIDAW Consumer App — Android launch themes (Phase 6: native startup).

  These theme resources are referenced by the launcher activity in
  AndroidManifest.xml:

    * android:theme="@style/LaunchTheme"            (activity attribute)
    * meta-data io.flutter.embedding.android.NormalTheme = "@style/NormalTheme"

  Before this file existed both references were dangling: a clean
  `flutter build apk` failed resource linking because @style/LaunchTheme and
  @style/NormalTheme had no definition anywhere in the checked-in project.

  Design intent (Part 4.1 / Part 6.1 "render first, initialize second"):

  The LaunchTheme is what the user sees from the moment the OS starts the
  process until Flutter attaches its first frame. It must be:
    - windowFullscreen: hides the status bar so the splash fills the screen
      (matches the immersive splash look of the app shell).
    - A drawable-only windowBackground: zero-cost draw; no bitmap decoding or
      layout inflation on the first-frame path. The branded visual is provided
      by the platform window mechanism, not by a Flutter-built imitation that
      only appears after the engine boots.
    - windowNoTitle: no ActionBar inflation during cold start.

  The NormalTheme is swapped in via the flutter_embedding_v2 NormalTheme
  meta-data once Flutter renders its first frame; it restores normal system
  UI behavior inside the app.

  Android 12+ (API 31): when androidx.core's SplashScreen API / the
  flutter_native_splash package is adopted for branded windowSplashScreen*
  artwork, these themes remain the pre-31 fallback and the post-splash
  NormalTheme; do not remove them.
-->
<resources>
    <!-- Theme applied to the Android Window while the process is starting
         when the OS, Semantic UI, system service, or the Flutter engine is
         still booting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Splash background shown until Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Keep the window opaque so nothing translucent forces an extra
             redraw pass before the first Flutter frame. -->
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Theme applied to the Android Window as soon as the process has
         started / once Flutter renders. Determines the Android Window color
         while Flutter is still painting; it does NOT affect the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FF0A2540</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
