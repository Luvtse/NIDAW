<?xml version="1.0" encoding="utf-8"?>
<!--
  NIDAW Driver App — Android launch themes (Phase 6: native startup).

  Mirrors apps/consumer_app/android/app/src/main/res/values/styles.xml so both
  entry points use the platform window mechanism for the pre-first-frame
  splash ("render first, initialize second", Part 4.1 / 4.3). Referenced by
  the launcher activity in this module's AndroidManifest.xml:

    * android:theme="@style/LaunchTheme"
    * meta-data io.flutter.embedding.android.NormalTheme = "@style/NormalTheme"

  The driver cold-start path additionally restores Hive boxes and dispatch
  state; none of that may block the window these themes paint. On API 31+
  adopt androidx.core SplashScreen / flutter_native_splash artwork on top of
  these themes; keep them as the pre-31 fallback.
-->
<resources>
    <!-- Theme applied to the Android Window while the process is starting
         when the OS, Semantic UI, system service, or the Flutter engine is
         still booting. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Splash background shown until Flutter draws its first frame. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- Theme applied to the Android Window once Flutter renders. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#FFFFFFFF</item>
        <item name="android:statusBarColor">#FF0A2540</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
